POSTGRES_PASSWORD=changeme
AUTH_SECRET=replace-with-a-random-32-byte-value
DOMAIN=your-domain.example.com

# Optional: real email delivery for announcements/reminders. Without these, emails are
# just logged to the web container's output instead of sent. See README for setup.
# Gmail SMTP (no domain required):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM=MyTenants <you@gmail.com>
# Or Resend (requires a verified domain), used only if SMTP_* above is unset:
# RESEND_API_KEY=
